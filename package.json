{
  "name": "safari-startpage",
  "version": "1.0.0",
  "private": true,
  "description": "An Apple-styled Safari start page (website) plus a Chrome MV3 extension that saves tabs into it.",
  "workspaces": [
    "web",
    "extension"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "dev:web": "npm run dev --workspace web",
    "dev:ext": "npm run dev --workspace extension",
    "build": "npm run build:web && npm run build:ext",
    "build:web": "npm run build --workspace web",
    "build:ext": "npm run build --workspace extension",
    "serve:web": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p extension/tsconfig.json",
    "newtab": "node scripts/toggle-newtab.mjs",
    "smoke": "vite build -c scripts/smoke/vite.config.mts && node .tmp/smoke/run.mjs",
    "test": "npm run smoke"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "jsdom": "^27.4.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
